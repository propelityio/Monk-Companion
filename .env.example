# Copy these into .env.local (local) and into Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# Supabase → Project Settings → Data API (URL) and API Keys (service_role / secret key)
SUPABASE_URL=https://hwtzhtduvtcgpgurqpab.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Optional model overrides
# ANTHROPIC_SEARCH_MODEL=claude-haiku-5-5
# ANTHROPIC_ANSWER_MODEL=claude-sonnet-5-5

# Optional calm voice (ElevenLabs). Without these, the browser's own voice is used.
# elevenlabs.io → Developers → API Keys; voice ID from the Voices page.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_multilingual_v2   # or eleven_flash_v2_5 (faster, about half the cost)
# ELEVENLABS_SPEED=1.0                      # 0.7 slowest … 1.2 fastest (1.0 ≈ 160 words/min)
